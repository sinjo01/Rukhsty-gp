DATABASE_URL=postgres://postgres:postgres@localhost:5432/rukhsty
SESSION_SECRET=replace-with-a-long-random-secret
PORT=8080
LOG_LEVEL=info

# Frontend Vite dev server
FRONTEND_PORT=5173
BASE_PATH=/

# Frontend API behavior
# Default is real API via Vite proxy. Set VITE_USE_MOCK=true only for offline UI demos.
VITE_USE_MOCK=false
API_PROXY_TARGET=http://localhost:8080
